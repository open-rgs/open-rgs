  .hwc .badge { animation: badgeIn 5s infinite; }
  .hwc .badge.b2 { animation: badgeTwo 5s infinite; }

  /* the board grows a row mid-cycle */
  @keyframes rowOpen { 0%,45%{opacity:0;transform:scaleY(.2)} 60%,100%{opacity:1;transform:none} }
