  .x1{animation:fsStep 5s infinite}.x2{animation:fsStep 5s infinite 1.2s}
  .x3{animation:fsStep 5s infinite 2.4s}.x4{animation:fsStep 5s infinite 3.6s}
  .fsw { font-size: .7rem; color: var(--dim, #8a8a8a); }

  @keyframes rtOpen { 0%,55%{opacity:.12} 65%,100%{opacity:1} }
  .meter .rt3, .meter .rt4, .meter .rt5 { animation: rtOpen 4s infinite; }
  .meter .rt4 { animation-delay: .08s } .meter .rt5 { animation-delay: .16s }
  @keyframes rtLabel { 0%,52%{opacity:0} 62%,88%{opacity:1} 96%,100%{opacity:0} }
  .rtlabel { color: #0E6B62; animation: rtLabel 4s infinite; }

