---
// Looped explainer animatics. Square divs, no rounded corners, CSS keyframes -
// no script, and `prefers-reduced-motion` stops every one of them.
//
// One component with a branch per `kind` so the markup lives in a single file
// and a page just names the idea it wants shown.
interface Props { kind: string; caption?: string }
const { kind, caption } = Astro.props;
const n = (k: number) => Array.from({ length: k });
---

<figure class="anim" data-kind={kind}>
  <div class="stage">

    {kind === "grid-ragged" && (
      <div class="row">
        <div class="colr"><i></i><i></i><i></i><i></i></div>
        <div class="colr"><i></i><i></i><i></i><i></i><i class="a blink"></i></div>
        <div class="colr"><i></i><i></i><i></i><i></i><i class="a blink"></i></div>
        <div class="colr"><i></i><i></i><i></i><i></i></div>
      </div>
    )}
    {kind === "grid-order" && (
      <div class="row">
        {n(4).map((_, c) => (
          <div class="colr">{n(3).map((_, r) => <i class={`seq s${c * 3 + r}`}></i>)}</div>
        ))}
      </div>
    )}
    {kind === "grid-neighbours" && (
      <div class="g3 nb">
        <i></i><i class="up"></i><i></i>
        <i class="lf"></i><i class="a"></i><i class="rt"></i>
        <i></i><i class="dn"></i><i></i>
      </div>
    )}

    {kind === "weights-bands" && (
      <div class="gauge"><span class="w60 a"></span><span class="w30 b"></span><span class="w10 c"></span><b class="ptr"></b></div>
    )}
    {kind === "weights-zero" && (
      <div class="gauge"><span class="w50 a"></span><span class="w0 ghost"></span><span class="w50 c"></span><b class="ptr"></b></div>
    )}
    {kind === "weights-distinct" && (
      <div class="row">{n(4).map((_, i) => <i class={`pickseq p${i}`}></i>)}</div>
    )}

    {kind === "selectors-pick" && (
      <div class="g3">{n(9).map((_, i) => <i class={i % 3 === 1 ? "pick" : ""}></i>)}</div>
    )}
    {kind === "selectors-compose" && (
      <div class="row">
        <div class="g3 sm">{n(9).map((_, i) => <i class={i < 3 ? "a" : ""}></i>)}</div>
        <span class="op">&minus;</span>
        <div class="g3 sm">{n(9).map((_, i) => <i class={i === 1 ? "b" : ""}></i>)}</div>
        <span class="op">=</span>
        <div class="g3 sm">{n(9).map((_, i) => <i class={i === 0 || i === 2 ? "a blink" : ""}></i>)}</div>
      </div>
    )}
    {kind === "selectors-random" && (
      <div class="g3 randg">{n(9).map(() => <i></i>)}</div>
    )}

    {kind === "fill-roll" && <div class="g3 rollg">{n(9).map(() => <i></i>)}</div>}
    {kind === "fill-percolumn" && (
      <div class="row">
        <div class="colr"><i></i><i></i><i></i></div>
        <div class="colr"><i></i><i class="a blink"></i><i></i></div>
        <div class="colr"><i class="a blink d1"></i><i></i><i></i></div>
        <div class="colr"><i></i><i></i><i class="a blink d2"></i></div>
        <div class="colr"><i></i><i></i><i></i></div>
      </div>
    )}
    {kind === "fill-expected" && (
      <div class="row">
        <div class="g3 sm">{n(9).map((_, i) => <i class={i === 2 || i === 6 ? "b blink" : ""}></i>)}</div>
        <span class="op">=</span><span class="num">0.9</span>
      </div>
    )}

    {kind === "markov-pair" && (
      <div class="row gap">
        <div><div class="colr roll loose">{n(6).map(() => <i></i>)}</div><em>s = 0</em></div>
        <div><div class="colr roll tight">{n(6).map(() => <i></i>)}</div><em>s = 0.8</em></div>
      </div>
    )}
    {kind === "markov-runs" && (
      <div class="colr"><i class="a"></i><i class="a"></i><i class="a"></i><i class="b"></i><i class="c"></i><i class="c"></i></div>
    )}
    {kind === "markov-stationary" && (
      <div class="row gap">
        <div class="gauge sm2"><span class="w60 a"></span><span class="w30 b"></span><span class="w10 c"></span></div>
        <span class="op">=</span>
        <div class="gauge sm2"><span class="w60 a"></span><span class="w30 b"></span><span class="w10 c"></span></div>
      </div>
    )}

    {kind === "recipes-mix" && (
      <div class="gauge"><span class="w94 a"></span><span class="w5 b"></span><span class="w1 c"></span><b class="ptr"></b></div>
    )}
    {kind === "recipes-tease" && (
      <div class="row">
        <div class="colr"><i class="b blink"></i><i></i><i></i></div>
        <div class="colr"><i></i><i class="b blink d1"></i><i></i></div>
        <div class="colr"><i></i><i></i><i></i></div>
        <div class="colr"><i></i><i></i><i></i></div>
        <div class="colr"><i></i><i></i><i></i></div>
      </div>
    )}
    {kind === "recipes-place" && (
      <div class="g3">{n(9).map((_, i) => <i class={i === 0 || i === 4 || i === 8 ? "a dropseq" : ""}></i>)}</div>
    )}

    {kind === "paytable-bands" && (
      <div class="gauge"><span class="w22 c"></span><span class="w20 b"></span><span class="w18 a"></span><span class="w40 a open"></span></div>
    )}
    {kind === "paytable-wild" && (
      <div class="row">
        <i class="wild"></i><span class="op">any of</span><i class="a blink"></i><i class="b blink d1"></i><i class="c blink d2"></i>
      </div>
    )}
    {kind === "paytable-topband" && (
      <div class="gauge"><span class="w20 c"></span><span class="w80 a open"></span></div>
    )}

    {kind === "pay-lines-run" && (
      <div class="g5">{n(15).map((_, i) => <i class={i >= 5 && i < 8 ? "run" : ""}></i>)}</div>
    )}
    {kind === "pay-lines-wildopen" && (
      <div class="row">
        <i class="wild"></i><i class="wild"></i><i class="a"></i><i class="a"></i><i class="a"></i>
        <span class="op">=</span><span class="num">5&times;A</span>
      </div>
    )}
    {kind === "pay-lines-bothways" && (
      <div class="row">
        <i></i><i></i><i class="run"></i><i class="run d1"></i><i class="run d2"></i>
        <span class="op arrowl">from the right</span>
      </div>
    )}

    {kind === "pay-ways-cols" && (
      <div class="row">
        <div class="colr"><i class="hit"></i><i class="hit"></i><i></i></div>
        <div class="colr"><i class="hit d1"></i><i></i><i></i></div>
        <div class="colr"><i class="hit d2"></i><i class="hit d2"></i><i class="hit d2"></i></div>
        <span class="op">=</span><span class="num">6</span>
      </div>
    )}
    {kind === "pay-ways-gap" && (
      <div class="row">
        <div class="colr"><i class="hit"></i><i></i></div>
        <div class="colr"><i class="hit"></i><i></i></div>
        <div class="colr gapx"><i></i><i></i></div>
        <div class="colr"><i class="hit faint"></i><i></i></div>
      </div>
    )}
    {kind === "pay-ways-heights" && (
      <div class="row gap">
        <div class="mw">
            <div class="mwf pwq1"><div class="mwc"><i class="a"></i><i class="a"></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i class="a"></i><i></i></div></div>
            <div class="mwf pwq2"><div class="mwc"><i class="a"></i><i class="a"></i><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i></i><i></i><i></i><i></i></div></div>
            <div class="mwf pwq3"><div class="mwc"><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i></i></div></div>
            <div class="mwf pwq4"><div class="mwc"><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i></div></div>
            <div class="mwf pwq5"><div class="mwc"><i class="a"></i><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i class="a"></i><i class="a"></i><i></i><i></i></div><div class="mwc"><i class="a"></i><i></i><i></i><i></i><i></i></div></div>
        </div>
        <div class="mwn">
          <span class="num pwq1">12 ways</span>
          <span class="num pwq2">6 ways</span>
          <span class="num pwq3">8 ways</span>
          <span class="num pwq4">16 ways</span>
          <span class="num pwq5">6 ways</span>
        </div>
      </div>
    )}

    {kind === "pay-anywhere-scatter" && (
      <div class="g3">{n(9).map((_, i) => <i class={[0, 4, 8].includes(i) ? "sc" : ""}></i>)}</div>
    )}
    {kind === "pay-anywhere-nowild" && (
      <div class="row">
        <i class="sc"></i><i class="wild strike"></i><i class="sc"></i>
        <span class="op">=</span><span class="num">2</span>
      </div>
    )}
    {kind === "pay-anywhere-trigger" && (
      <div class="row">
        <i class="sc"></i><i class="sc"></i><i class="sc d2 pop"></i>
        <span class="op">&ge;</span><span class="num">3</span>
      </div>
    )}

    {kind === "pay-cluster-wild" && (
      <div class="g3 wgrid">
        <i class="a lft"></i><i class="a lft"></i><i class="b rgt"></i>
        <i class="a lft"></i><i class="wild both"></i><i class="b rgt"></i>
        <i class="c"></i><i class="b rgt"></i><i class="b rgt"></i>
      </div>
    )}
    {kind === "pay-cluster-flood" && (
      <div class="g3">
        <i class="a fl0"></i><i class="a fl1"></i><i></i>
        <i class="a fl1"></i><i class="a fl2"></i><i></i>
        <i></i><i class="a fl3"></i><i></i>
      </div>
    )}
    {kind === "pay-cluster-diag" && (
      <div class="g3">
        <i class="a"></i><i></i><i></i>
        <i></i><i class="a"></i><i></i>
        <i></i><i></i><i class="a"></i>
      </div>
    )}

    {kind === "cascade-fall" && (
      <div class="casc"><i class="a s0"></i><i class="b s1"></i><i class="c s2"></i><i class="a s3"></i></div>
    )}
    {kind === "cascade-ladder" && (
      <div class="row">
        <span class="num st1">1&times;</span><span class="num st2">2&times;</span>
        <span class="num st3">3&times;</span><span class="num st4">5&times;</span>
      </div>
    )}
    {kind === "cascade-bounded" && (
      <div class="row"><div class="gauge sm2"><span class="w80 a"></span><span class="w20 stop"></span></div></div>
    )}

    {kind === "holdwin-meter" && (
      <div class="row gap">
        <div class="meter"><i class="a"></i><i class="a m2"></i><i class="a m3"></i></div>
        <i class="b landing"></i>
      </div>
    )}
    {kind === "holdwin-collect" && (
      <div class="row">
        <i class="a pull"></i><i class="b fade1"></i><i class="b fade2"></i><i class="b fade3"></i>
      </div>
    )}
    {kind === "holdwin-tiers" && (
      <div class="row">
        <i class="c"></i><i class="b"></i><i class="a"></i><i class="a big"></i>
      </div>
    )}
    {kind === "holdwin-land" && (
      <div class="hw">
        <span class="hwc coin">1</span><span class="hwc coin">2</span><span class="hwc land l1">5</span>
        <span class="hwc land l2">1</span><span class="hwc coin">1</span><span class="hwc hole"></span>
        <span class="hwc hole"></span><span class="hwc land l3">2</span><span class="hwc coin">3</span>
      </div>
    )}
    {kind === "holdwin-collect" && (
      <div class="hw">
        <span class="hwc coin eat e1">1</span><span class="hwc coin eat e2">3</span><span class="hwc hole"></span>
        <span class="hwc coin eat e3">2</span><span class="hwc pot">C<b class="tot">18</b></span><span class="hwc coin eat e4">5</span>
        <span class="hwc hole"></span><span class="hwc coin eat e5">2</span><span class="hwc coin eat e6">4</span>
      </div>
    )}
    {kind === "holdwin-mystery" && (
      <div class="hw">
        <span class="hwc coin">2</span><span class="hwc hole"></span><span class="hwc coin">1</span>
        <span class="hwc q">?<b class="flip">7</b></span><span class="hwc coin">3</span><span class="hwc q d1">?<b class="flip f1">7</b></span>
        <span class="hwc hole"></span><span class="hwc q d2">?<b class="flip f2">7</b></span><span class="hwc coin">1</span>
      </div>
    )}
    {kind === "holdwin-cellmult" && (
      <div class="hw">
        <span class="hwc coin">1</span><span class="hwc hole"></span><span class="hwc coin">2</span>
        <span class="hwc hole"></span><span class="hwc xcell">3<b class="badge">&times;2</b><b class="badge b2">&times;5</b></span><span class="hwc coin">1</span>
        <span class="hwc coin">4</span><span class="hwc hole"></span><span class="hwc hole"></span>
      </div>
    )}
    {kind === "holdwin-expand" && (
      <div class="hw grow">
        <span class="hwc coin">1</span><span class="hwc coin">5</span><span class="hwc hole"></span>
        <span class="hwc hole"></span><span class="hwc coin">2</span><span class="hwc coin">1</span>
        <span class="hwc hole new n1"></span><span class="hwc hole new n2"></span><span class="hwc hole new n3"></span>
      </div>
    )}
    {kind === "fs-multiplier" && (
      <div class="row gap">
        <span class="num fsx x1">1&times;</span><span class="num fsx x2">2&times;</span>
        <span class="num fsx x3">3&times;</span><span class="num fsx x4">5&times;</span>
        <span class="fsw">win &times; the one showing</span>
      </div>
    )}
    {kind === "fs-retrigger" && (
      <div class="row gap">
        <div class="meter"><i class="a"></i><i class="a"></i><i class="a rt3"></i><i class="a rt4"></i><i class="a rt5"></i></div>
        <span class="num rtlabel">+3</span>
      </div>
    )}
    {kind === "fs-sticky" && (
      <div class="hw">
        <span class="hwc coin">W</span><span class="hwc spun s1">A</span><span class="hwc spun s2">K</span>
        <span class="hwc spun s3">Q</span><span class="hwc coin">W</span><span class="hwc spun s1">J</span>
        <span class="hwc spun s2">A</span><span class="hwc spun s3">K</span><span class="hwc coin">W</span>
      </div>
    )}
    {kind === "picks-pool" && (
      <div class="hw">
        <span class="hwc box b1">?</span><span class="hwc box b2">?</span><span class="hwc box b3">?</span>
        <span class="hwc box b4">?</span><span class="hwc box b5">?</span><span class="hwc box b6">?</span>
      </div>
    )}
    {kind === "picks-wheel" && (
      <div class="row gap">
        <span class="num wseg w1">MINI</span><span class="num wseg w2">MINOR</span>
        <span class="num wseg w3">MAJOR</span><span class="num wseg w4">GRAND</span>
      </div>
    )}
    {kind === "strips-window" && (
      <div class="row gap">
        <div class="strip"><i>A</i><i>W</i><i>W</i><i>W</i><i>B</i><i>C</i><i>A</i><i>B</i><span class="win"></span></div>
        <span class="fsw">the window slides, the reel does not change</span>
      </div>
    )}
    {kind === "gamble-ladder" && (
      <div class="row gap">
        <span class="num gstep g1">1&times;</span><span class="num gstep g2">2&times;</span>
        <span class="num gstep g3">4&times;</span><span class="num gbust">bust</span>
      </div>
    )}
    {kind === "meter-fill" && (
      <div class="row gap">
        <div class="gauge"><span class="mfill"></span></div>
        <span class="num mpay">MINI</span><span class="num mpay mp2">MINOR</span>
      </div>
    )}
    {kind === "symbols-transform" && (
      <div class="hw">
        <span class="hwc coin tf">L</span><span class="hwc coin tf t2">L</span><span class="hwc hole"></span>
        <span class="hwc hole"></span><span class="hwc coin tf t3">L</span><span class="hwc coin">H</span>
        <span class="hwc coin tf t4">L</span><span class="hwc hole"></span><span class="hwc hole"></span>
      </div>
    )}
    {kind === "holdwin-full" && (
      <div class="g3">{n(9).map((_, i) => <i class={`a fillseq f${i}`}></i>)}</div>
    )}
    {kind === "multiways-heights" && (
      <div class="row gap">
        <div class="mw">
            <div class="mwf mwq1"><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div><div class="mwc">{n(4).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq2"><div class="mwc">{n(5).map(() => <i class="a"></i>)}</div><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(6).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq3"><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div><div class="mwc">{n(7).map(() => <i class="a"></i>)}</div><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq4"><div class="mwc">{n(4).map(() => <i class="a"></i>)}</div><div class="mwc">{n(4).map(() => <i class="a"></i>)}</div><div class="mwc">{n(4).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq5"><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(7).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq6"><div class="mwc">{n(6).map(() => <i class="a"></i>)}</div><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq7"><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div><div class="mwc">{n(5).map(() => <i class="a"></i>)}</div><div class="mwc">{n(5).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq8"><div class="mwc">{n(7).map(() => <i class="a"></i>)}</div><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(3).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq9"><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div><div class="mwc">{n(6).map(() => <i class="a"></i>)}</div><div class="mwc">{n(4).map(() => <i class="a"></i>)}</div></div>
            <div class="mwf mwq10"><div class="mwc">{n(5).map(() => <i class="a"></i>)}</div><div class="mwc">{n(5).map(() => <i class="a"></i>)}</div><div class="mwc">{n(2).map(() => <i class="a"></i>)}</div></div>
        </div>
        <div class="mwn">
          <span class="num mwq1">24 ways</span>
          <span class="num mwq2">60 ways</span>
          <span class="num mwq3">63 ways</span>
          <span class="num mwq4">64 ways</span>
          <span class="num mwq5">28 ways</span>
          <span class="num mwq6">36 ways</span>
          <span class="num mwq7">75 ways</span>
          <span class="num mwq8">42 ways</span>
          <span class="num mwq9">48 ways</span>
          <span class="num mwq10">50 ways</span>
        </div>
      </div>
    )}
    {kind === "multiways-product" && (
      <div class="row"><span class="num">2</span><span class="op">&times;</span><span class="num">3</span><span class="op">&times;</span><span class="num">4</span><span class="op">=</span><span class="num big2">24</span></div>
    )}

    {kind === "big-fit" && (
      <div class="row">
        <div class="colr"><i></i><i></i><i></i><i></i></div>
        <div class="colr"><i></i><i class="a bigblk"></i><i class="a bigblk"></i><i></i></div>
        <div class="colr"><i></i><i class="a bigblk"></i><i class="a bigblk"></i><i></i></div>
        <div class="colr short"><i></i><i></i></div>
      </div>
    )}
    {kind === "big-counts" && (
      <div class="row">
        <div class="g2 blk"><i class="a"></i><i class="a"></i><i class="a"></i><i class="a"></i></div>
        <span class="op">=</span><span class="num">4</span>
      </div>
    )}

    {kind === "spawn-count" && (
      <div class="gauge"><span class="w90 dimb"></span><span class="w7 a"></span><span class="w25 b"></span><span class="w05 c"></span><b class="ptr"></b></div>
    )}
    {kind === "spawn-onereel" && (
      <div class="row">
        {n(5).map((_, c) => (
          <div class="colr">{n(3).map((_, r) => <i class={r === (c % 3) && c !== 4 ? `sc pop d${c}` : ""}></i>)}</div>
        ))}
      </div>
    )}
    {kind === "spawn-protect" && (
      <div class="row">
        <i class="wild lock"></i><i class="sc pop"></i><i class="wild lock"></i><i class="sc pop d1"></i>
      </div>
    )}

    {kind === "retry-inflight" && (
      <div class="row gap">
        <div class="colr">
          <span class="tok">tok-A</span>
          <span class="tok rq2">tok-A</span>
        </div>
        <div class="gauge sm2 track"><span class="w90 a runbar"></span></div>
        <span class="num">1 round</span>
      </div>
    )}
    {kind === "retry-fail" && (
      <div class="row gap">
        <div class="colr">
