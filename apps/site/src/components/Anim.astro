  @keyframes rollA {0%{background:#0E6B62;border-color:#0E6B62}33%{background:#8A5A15;border-color:#8A5A15}66%{background:#4A6570;border-color:#4A6570}}
  @keyframes rollB {0%{background:#8A5A15;border-color:#8A5A15}33%{background:#4A6570;border-color:#4A6570}66%{background:#0E6B62;border-color:#0E6B62}}
  @keyframes rollC {0%{background:#4A6570;border-color:#4A6570}33%{background:#0E6B62;border-color:#0E6B62}66%{background:#8A5A15;border-color:#8A5A15}}
  .rollg i { animation: rollA 3s infinite steps(1,end); }
