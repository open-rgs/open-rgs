      </div>
    )}
    {kind === "universal-probe" && (
      <div class="colr">
        <div class="row"><span class="lane">spin</span><span class="tok bad">INVALID_MODE</span></div>
        <div class="row"><span class="lane">open</span><i class="a uq1"></i><i class="a uq2"></i><i class="a uq3"></i><span class="op">close</span></div>
      </div>
    )}

  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
