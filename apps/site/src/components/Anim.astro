  .tight i:nth-child(1),.tight i:nth-child(2),.tight i:nth-child(3){animation-name:rollA}
  .tight i:nth-child(4),.tight i:nth-child(5){animation-name:rollB}
  .tight i:nth-child(6){animation-name:rollC}

  @keyframes runFlash { 0%,30%{background:var(--bg-soft,#eee)} 40%,80%{background:#0E6B62;border-color:#0E6B62} 100%{background:var(--bg-soft,#eee)} }
  .run { animation: runFlash 3s infinite; }
