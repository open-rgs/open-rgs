  /* Longhands, not the `animation` shorthand: this selector outranks the
     .pwqN delay rules below, and the shorthand would reset their delay to 0
     and stack all five frames on top of each other. */
  .mwf.pwq1, .mwf.pwq2, .mwf.pwq3, .mwf.pwq4, .mwf.pwq5,
  .mwn .num.pwq1, .mwn .num.pwq2, .mwn .num.pwq3, .mwn .num.pwq4, .mwn .num.pwq5 {
