      <div class="colr">
        <div class="row"><span class="lane">player-a</span><span class="tok">k</span><i class="a"></i></div>
        <div class="row"><span class="lane">player-b</span><span class="tok">k</span><i class="b"></i></div>
      </div>
    )}
    {kind === "ops-decode" && (
      <div class="row">
        <i class="a uq1"></i><i class="a uq2"></i><i class="a uq3"></i><i class="faint"></i>
        <span class="op">3 rendered, 1 passed through</span>
      </div>
    )}
    {kind === "ops-total" && (
      <div class="row gap">
        <div class="row"><i class="a"></i><span class="num">2</span><span class="op">+</span><i class="a"></i><span class="num">1</span></div>
