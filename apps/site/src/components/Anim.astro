  @keyframes gBust { 0%,58%{opacity:0} 68%,88%{opacity:1;color:#9E1C2F} 96%,100%{opacity:0} }
  .gbust { opacity: 0; animation: gBust 5s infinite; }

  /* --- meters: a bar that fills and pays what it passed --------------------- */
  .gauge .mfill { display:block; height:100%; background:#0E6B62; width:0; animation: mFill 6s infinite; }
  @keyframes mFill { 0%{width:0} 45%{width:55%} 70%{width:100%} 100%{width:100%} }
  @keyframes mPay { 0%,40%{opacity:0} 48%,62%{opacity:1;color:#0E6B62} 70%,100%{opacity:0} }
  @keyframes mPay2 { 0%,66%{opacity:0} 74%,92%{opacity:1;color:#0E6B62} 98%,100%{opacity:0} }
  .mpay { opacity: 0; animation: mPay 6s infinite; }
  .mpay.mp2 { animation: mPay2 6s infinite; }

  /* --- symbols: the lows all become premiums at once ----------------------- */
  @keyframes toPrem { 0%,45%{opacity:1} 55%,100%{opacity:1;background:#0E6B62;color:#041614} }
  .hwc.tf { animation: toPrem 4s infinite; }
  .t2{animation-delay:.05s}.t3{animation-delay:.1s}.t4{animation-delay:.15s}

  /* --- free spins: the multiplier, the counter, the held cells ------------- */
  @keyframes fsStep { 0%,100%{opacity:.22} 18%{opacity:1;color:#0E6B62} }
