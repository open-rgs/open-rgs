  .mw .pwq1, .mwn .pwq1 { animation-delay: 0.0s }
  .mw .pwq2, .mwn .pwq2 { animation-delay: 1.2s }
  .mw .pwq3, .mwn .pwq3 { animation-delay: 2.4s }
  .mw .pwq4, .mwn .pwq4 { animation-delay: 3.6s }
  .mw .pwq5, .mwn .pwq5 { animation-delay: 4.8s }
  @keyframes frameShow5 { 0%{opacity:0} 4%,16%{opacity:1} 20%,100%{opacity:0} }

  @keyframes scPulse { 0%,100%{background:#8A5A15;border-color:#8A5A15} 50%{background:var(--bg-soft,#eee);border-color:var(--fg-mute,#888)} }
