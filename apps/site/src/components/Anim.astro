    background: #0E6B62; color: #041614; font-size: .6rem; font-weight: 700;
  }
  @keyframes badgeIn  { 0%,12%{opacity:0;transform:scale(.6)} 22%,58%{opacity:1;transform:none} 66%,100%{opacity:0} }
