  /* Multiways: reels always fill the SAME height however many symbols they
     hold, so the board reads as one board reconfiguring rather than columns
     growing and shrinking. Ten configurations cycle in sequence; the ways
     count changes with them.

     The frame classes are mwq1..mwq10 rather than f1..f10 on purpose - an
     earlier version used f1/f2/f3, which already carry the hold-and-win
     fill delays defined later in this file. The later rule won, every frame
     got a delay under half a second, and all ten appeared at once. */
  .mw { position: relative; width: 78px; height: 84px; }
  .mwf {
    position: absolute; inset: 0; display: flex; gap: 3px;
    opacity: 0; animation: frameShow 12s infinite;
  }
  .mwc { display: flex; flex-direction: column; gap: 2px; flex: 1 1 0; height: 100%; }
  .mwc i { flex: 1 1 0; width: auto; height: auto; min-height: 0; }
  .mwn { position: relative; width: 74px; height: 1.1rem; }
  .mwn .num { position: absolute; left: 0; top: 0; opacity: 0; animation: frameShow 12s infinite; }
  /* Both selectors per frame: `.mwn .num` sets the `animation` shorthand and
     outranks a bare `.mwqN`, which zeroed every readout's delay and left all
     ten ways counts firing at once against a board that had moved on. */
  .mw .mwq1, .mwn .mwq1 { animation-delay: 0.0s }
  .mw .mwq2, .mwn .mwq2 { animation-delay: 1.2s }
  .mw .mwq3, .mwn .mwq3 { animation-delay: 2.4s }
  .mw .mwq4, .mwn .mwq4 { animation-delay: 3.6s }
  .mw .mwq5, .mwn .mwq5 { animation-delay: 4.8s }
  .mw .mwq6, .mwn .mwq6 { animation-delay: 6.0s }
  .mw .mwq7, .mwn .mwq7 { animation-delay: 7.2s }
  .mw .mwq8, .mwn .mwq8 { animation-delay: 8.4s }
  .mw .mwq9, .mwn .mwq9 { animation-delay: 9.6s }
  .mw .mwq10, .mwn .mwq10 { animation-delay: 10.8s }
  /* 1.2s per configuration across a 12s loop: visible for one slot, faded
     for the other nine. */
  @keyframes frameShow { 0%{opacity:0} 2%,8%{opacity:1} 10%,100%{opacity:0} }

  /* pay-ways uses the same reconfiguring board, with five frames over 6s
     rather than ten over 12s. Its own frame classes for the reason spelled
